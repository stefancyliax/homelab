{
	# Global options
	# email your@email.com # Recommended: Uncomment and add your email for Let's Encrypt expiration notices
}

*.home.stefancyliax.de {
	tls {
		dns porkbun {
			api_key {$PORKBUN_API_KEY}
			api_secret_key {$PORKBUN_API_SECRET_KEY}
		}
		resolvers 1.1.1.1 8.8.8.8
	}

	# Homepage (Protected by Authelia)
	@homepage host homepage.home.stefancyliax.de
	handle @homepage {
		forward_auth authelia:9091 {
			uri /api/verify?rd=https://auth.home.stefancyliax.de/
			copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
		}
		reverse_proxy homepage:3000
	}

	# Prometheus (Protected by Authelia)
	@prometheus host prometheus.home.stefancyliax.de
	handle @prometheus {
		forward_auth authelia:9091 {
			uri /api/verify?rd=https://auth.home.stefancyliax.de/
			copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
		}
		reverse_proxy prometheus:9090
	}

	# Grafana (Protected by Authelia)
	@grafana host grafana.home.stefancyliax.de
	handle @grafana {
		forward_auth authelia:9091 {
			uri /api/verify?rd=https://auth.home.stefancyliax.de/
			copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
		}
		reverse_proxy grafana:3000
	}

	# Ntfy (Direct Proxy, Unprotected)
	@ntfy host ntfy.home.stefancyliax.de
	handle @ntfy {
		reverse_proxy ntfy:80
	}

	# Grimmory (OIDC SSO handled by the application)
	@grimmory host grimmory.home.stefancyliax.de
	handle @grimmory {
		reverse_proxy 10.1.23.224:6060
	}

	# Proxmox (OIDC SSO handled by Proxmox's built-in OpenID Connect realm)
	@proxmox host proxmox.home.stefancyliax.de
	handle @proxmox {
		reverse_proxy https://10.1.23.4:8006 {
			transport http {
				tls_insecure_skip_verify
			}
		}
	}

	# Dockhand (OIDC SSO handled by the application)
	@dockhand host dockhand.home.stefancyliax.de
	handle @dockhand {
		reverse_proxy dockhand:3000
	}


	# Paperless-ngx (OIDC SSO handled by the application)
	@paperless host paperless.home.stefancyliax.de
	handle @paperless {
		reverse_proxy 10.1.23.224:8008
	}


	# Syncthing Hermes Node (Direct Proxy, uses Syncthing's built-in authentication)
	@syncthing-hermes host syncthing-hermes-node.home.stefancyliax.de
	handle @syncthing-hermes {
		reverse_proxy 10.1.23.216:8384
	}

	# Hindsight Control Plane (Protected by Authelia)
	@hindsight host hindsight.home.stefancyliax.de
	handle @hindsight {
		forward_auth authelia:9091 {
			uri /api/verify?rd=https://auth.home.stefancyliax.de/
			copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
		}
		reverse_proxy 10.1.23.224:9999
	}

	# Hindsight API (Direct Proxy, Unprotected for API/Agent access)
	@hindsight-api host hindsight-api.home.stefancyliax.de
	handle @hindsight-api {
		reverse_proxy 10.1.23.224:8888
	}

	# Open-WebUI (OIDC SSO handled by the application)
	@open-webui host open-webui.home.stefancyliax.de
	handle @open-webui {
		reverse_proxy 10.1.23.224:3000
	}

	# NextExplorer (OIDC SSO handled by the application)
	@nextexplorer host nextexplorer.home.stefancyliax.de
	handle @nextexplorer {
		reverse_proxy 10.1.23.224:3001
	}

	# NocoDB (Protected by Authelia)
	@nocodb host nocodb.home.stefancyliax.de
	handle @nocodb {
		forward_auth authelia:9091 {
			uri /api/verify?rd=https://auth.home.stefancyliax.de/
			copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
		}
		reverse_proxy 10.1.23.224:8080
	}

	# Paperless-GPT (Protected by Authelia)
	@paperless-gpt host paperless-gpt.home.stefancyliax.de
	handle @paperless-gpt {
		forward_auth authelia:9091 {
			uri /api/verify?rd=https://auth.home.stefancyliax.de/
			copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
		}
		reverse_proxy 10.1.23.224:8002
	}

	# ZeroByte (Protected by Authelia)
	@zerobyte host zerobyte.home.stefancyliax.de
	handle @zerobyte {
		forward_auth authelia:9091 {
			uri /api/verify?rd=https://auth.home.stefancyliax.de/
			copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
		}
		reverse_proxy 10.1.23.224:4096
	}

	# Fallback for undefined subdomains
	handle {
		respond "Service Not Found" 404
	}
}

# Authelia Login Portal
auth.home.stefancyliax.de {
	tls {
		dns porkbun {
			api_key {$PORKBUN_API_KEY}
			api_secret_key {$PORKBUN_API_SECRET_KEY}
		}
		resolvers 1.1.1.1 8.8.8.8
	}
	reverse_proxy authelia:9091
}
