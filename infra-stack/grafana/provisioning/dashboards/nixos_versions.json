{
  "annotations": {
    "list": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "VictoriaMetrics"
        },
        "enable": true,
        "iconColor": "purple",
        "name": "New commit",
        "expr": "count by (commit) (label_replace(comin_deployment_info{commit_id!=\"\"}, \"commit\", \"$1\", \"commit_id\", \"^(.{7}).*\")) unless count by (commit) (label_replace(comin_deployment_info{commit_id!=\"\"}, \"commit\", \"$1\", \"commit_id\", \"^(.{7}).*\") offset 2m)",
        "step": "60s",
        "titleFormat": "Commit {{commit}} appeared",
        "textFormat": "",
        "tagKeys": "",
        "useValueForTime": false
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "title": "Commits on main",
      "type": "link",
      "url": "https://github.com/stefancyliax/homelab/commits/main",
      "targetBlank": true,
      "icon": "external link"
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "description": "Newest commit Comin has deployed anywhere in the fleet, and when it first landed. Comin deploys the head of main, so this is the rollout target.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "dateTimeFromNow",
          "links": [
            {
              "title": "Open commit on GitHub",
              "url": "https://github.com/stefancyliax/homelab/commit/${__field.labels.commit_id}",
              "targetBlank": true
            }
          ]
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "editorMode": "code",
          "expr": "label_replace(topk(1, min by (commit_id) (tfirst_over_time(comin_deployment_info{commit_id!=\"\"}[90d]))), \"commit\", \"$1\", \"commit_id\", \"^(.{7}).*\") * 1000",
          "legendFormat": "{{commit}}",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Latest commit",
      "type": "stat"
    },
